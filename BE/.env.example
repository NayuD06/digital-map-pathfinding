PORT=8000
# Toàn TP.HCM theo ranh giới mới. Chạy thử nhanh với 1 quận: District 1, Ho Chi Minh City, Vietnam
# (kèm GRAPH_BUFFER_KM=0)
PLACE_NAME=Ho Chi Minh City, Vietnam
CORS_ORIGINS=http://localhost:5173
# Nới ranh giới thêm N km để tìm được đường qua tỉnh lân cận (TP.HCM -> Vũng Tàu đi qua Đồng Nai).
# Chạy với 1 quận thì đặt 0.
GRAPH_BUFFER_KM=10
# Để trống thì tự đặt theo tên bản đồ: data/ho-chi-minh-city-vietnam-10-km.graphml
GRAPH_CACHE_PATH=
# Dự phòng khi không tải được theo tên: west,south,east,north (để trống thì dùng PLACE_NAME)
GRAPH_BBOX=
# Máy chủ Overpass để tải bản đồ, để trống thì dùng overpass-api.de.
# Khi máy chủ chính quá tải (lỗi 502/504) có thể dùng: https://maps.mail.ru/osm/tools/overpass/api
OVERPASS_URL=

# MySQL: điền MYSQL_DATABASE để lưu bản đồ, lịch sử tìm đường, benchmark.
# Database chưa có sẽ được tạo tự động. Để trống MYSQL_DATABASE thì chạy không cần MySQL.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=
